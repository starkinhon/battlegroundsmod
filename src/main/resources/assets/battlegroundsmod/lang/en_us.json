  "ability.battlegroundsmod.destruction_god.0.desc": "Hold to charge a ringed energy sphere over your hand. Let go to throw it homing at the target; with no target it follows your aim until it finds someone and blows up everything around.",
  "ability.battlegroundsmod.destruction_god.0.tags": "Projectile,Homing,Charged",
  "ability.battlegroundsmod.destruction_god.1.desc": "Freezes the target, flicks it up into the air, vanishes and reappears behind it for a slap that drives it back into the ground.",
  "ability.battlegroundsmod.destruction_god.1.tags": "Combo,Teleport",
  "ability.battlegroundsmod.destruction_god.2.desc": "From space, creates a sun of pure destruction that falls from the sky onto the target. The impact wrecks everything in a huge radius.",
  "ability.battlegroundsmod.destruction_god.2.tags": "Cutscene,Area",
  "ability.battlegroundsmod.destruction_god.3.desc": "Erases from existence anyone under 20% health. Above that, summons a Hakai ball that chases the target, traps it and explodes.",
  "ability.battlegroundsmod.destruction_god.3.tags": "Execute,Cutscene",
  "ability.battlegroundsmod.destruction_god.4.desc": "Point at the target and hold to keep a tiny sphere of destruction at your finger. Let go: it flies up and chases the target, implodes into a giant sun and comes down on it. The explosion rises in smoke, rewinds and blows up again with a shockwave.",
  "ability.battlegroundsmod.destruction_god.4.tags": "Homing,Charged,Area,Destruction",
  "ability.battlegroundsmod.destruction_god.5.desc": "Rises into the air, intangible, and fires a rain of energy spheres from the whole body at the target, then glides down. A strong stun cancels it.",
  "ability.battlegroundsmod.destruction_god.5.tags": "Projectile,Intangible",
  "ability.battlegroundsmod.destruction_god.8.desc": "A tiny spark that flies straight and pulverizes everything it touches, even other powers' attacks. Anyone under 20% health is disintegrated.",
  "ability.battlegroundsmod.destruction_god.8.tags": "Projectile,Erases attacks",
  "ability.battlegroundsmod.destruction_god.9.desc": "Rises into the sky and drops a tiny white ball. The ground cracks into lava and bursts into plasma, pulverizing everything in a colossal radius.",
  "ability.battlegroundsmod.destruction_god.9.tags": "Area,Destruction",
  "ability.battlegroundsmod.uchiha_ghost.0.desc": "Breathes a stream of fire, burning and slowing everyone in the cone.",
  "ability.battlegroundsmod.uchiha_ghost.0.tags": "Cone,Fire",
  "ability.battlegroundsmod.uchiha_ghost.1.desc": "The Mangekyo eyes catch whoever is in front: stuns, blinds and seals the target's abilities for a few seconds.",
  "ability.battlegroundsmod.uchiha_ghost.1.tags": "Stun,Seals skills",
  "ability.battlegroundsmod.uchiha_ghost.2.desc": "Stands guard for a moment. Whoever strikes is grabbed by the Susanoo's arm, crushed and thrown.",
  "ability.battlegroundsmod.uchiha_ghost.2.tags": "Counter,Grab",
  "ability.battlegroundsmod.uchiha_ghost.3.desc": "Calls a giant meteor that tears through the clouds and falls on the target.",
  "ability.battlegroundsmod.uchiha_ghost.3.tags": "Area,Cutscene",
  "ability.battlegroundsmod.uchiha_ghost.4.desc": "Rushes the target and grabs it by the neck in a cinematic strike.",
  "ability.battlegroundsmod.uchiha_ghost.4.tags": "Grab,Cutscene",
  "ability.battlegroundsmod.uchiha_ghost.5.desc": "Jumps, stops in the air and charges a fireball that grows while the key is held. Let go to throw it.",
  "ability.battlegroundsmod.uchiha_ghost.5.tags": "Charged,Fire",
  "ability.battlegroundsmod.uchiha_ghost.6.desc": "Records the next 30 seconds around you. Then rewrites fate: everything goes back to the start and whoever died is left a ghost.",
  "ability.battlegroundsmod.uchiha_ghost.6.tags": "Time",
  "ability.battlegroundsmod.uchiha_ghost.7.desc": "The Susanoo's sword cuts a huge line ahead, splitting blocks and enemies.",
  "ability.battlegroundsmod.uchiha_ghost.7.tags": "Slash,Destruction",
  "ability.battlegroundsmod.uchiha_ghost.8.desc": "Two meteors fall one after the other on the target.",
  "ability.battlegroundsmod.uchiha_ghost.8.tags": "Area"
}
