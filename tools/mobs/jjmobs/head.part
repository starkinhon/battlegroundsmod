<title>Mobs de Jujutsu</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Russo+One&family=Inter:wght@400;600&family=JetBrains+Mono:wght@400&display=swap">
<style>
/* Layout: palco 3D grande à esquerda, painel do mob à direita; embaixo a tabela de spawn por bioma. Tema único escuro (céu de fim de tarde). */
:root {
  --bg: #12151d; --panel: #1b202b; --line: #2c3342; --fg: #e9ecf2; --mute: #9aa3b5;
  --accent: #8f7cff; --accent-fg: #0e0a22; --good: #6fcf7a; --warn: #f2c14e; --bad: #ef6b5b;
  --f-display: "Russo One", "Arial Black", sans-serif; --f-body: Inter, system-ui, sans-serif; --f-mono: "JetBrains Mono", ui-monospace, monospace;
  color-scheme: dark;
}
body { background: var(--bg); color: var(--fg); font-family: var(--f-body); }
.wrap { padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); padding-block: 18px 40px; max-width: 1280px; margin: 0 auto; display: grid; gap: 18px; }
header h1 { font-family: var(--f-display); font-weight: 400; font-size: clamp(22px, 3vw, 32px); margin: 0; letter-spacing: .01em; text-wrap: balance; }
header p { color: var(--mute); margin: 4px 0 0; max-width: 70ch; line-height: 1.5; }
.tabs { display: flex; flex-wrap: wrap; gap: 8px; }
.tabs button, .seg button { font: 600 13px var(--f-body); color: var(--fg); background: var(--panel); border: 1px solid var(--line); border-radius: 999px; padding: 7px 14px; cursor: pointer; }
.tabs button[aria-pressed="true"] { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); }
.tabs button small { font-weight: 400; opacity: .75; margin-left: 4px; }
.main { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 18px; }
@media (max-width: 900px) { .main { grid-template-columns: minmax(0, 1fr); } }
.stage { position: relative; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; aspect-ratio: 4 / 3; max-width: 100%; touch-action: none; }
.stage canvas { display: block; width: 100%; height: 100%; cursor: grab; }
.hud { position: absolute; left: 10px; right: 10px; bottom: 10px; display: flex; flex-wrap: wrap; gap: 8px; justify-content: space-between; pointer-events: none; }
.seg { display: flex; gap: 4px; pointer-events: auto; background: rgba(10, 12, 18, .7); padding: 4px; border-radius: 999px; }
.seg button { padding: 5px 11px; border: 0; background: transparent; }
.seg button[aria-pressed="true"] { background: var(--accent); color: var(--accent-fg); }
.side { display: grid; gap: 14px; align-content: start; min-width: 0; }
.card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; min-width: 0; }
.card h2 { font-family: var(--f-display); font-weight: 400; font-size: 22px; margin: 0; }
.card .bio { color: var(--accent); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; margin-top: 2px; }
dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 12px; margin: 12px 0 0; font-size: 13px; line-height: 1.45; }
dt { color: var(--mute); }
dd { margin: 0; }
.tex { display: flex; gap: 12px; align-items: start; }
.tex canvas { image-rendering: pixelated; width: 128px; height: 128px; background: repeating-conic-gradient(#222 0 25%, #2a2a2a 0 50%) 0 0 / 16px 16px; border-radius: 4px; flex: none; }
.tex p { margin: 0; font-size: 12px; color: var(--mute); line-height: 1.45; }
.mono { font-family: var(--f-mono); font-size: 12px; }
.var { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
h3 { font-family: var(--f-display); font-weight: 400; font-size: 20px; margin: 6px 0 0; }
.tablewrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; }
table { border-collapse: collapse; width: 100%; min-width: 760px; font-size: 13px; }
th, td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--line); vertical-align: top; line-height: 1.45; }
th { color: var(--mute); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; background: var(--panel); }
tr:last-child td { border-bottom: 0; }
.pill { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; margin-right: 4px; }
.novo { background: var(--accent); color: var(--accent-fg); }
.fica { background: #2b3a2d; color: var(--good); }
.sai { background: #3d2522; color: var(--bad); }
.note { color: var(--mute); font-size: 13px; line-height: 1.5; max-width: 80ch; margin: 0; }
button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>

<div class="wrap">
